# VibeCheck Environment Variables (Copy to .env.local and fill in your keys)
# Both keys are read server-side only inside Next.js API routes and never exposed to the browser.

# Required for live claim extraction and spec-drift reasoning (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended for GitHub REST API evidence & commit diff retrieval (raises rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: override primary Gemini model (default: gemini-3-flash-preview, fallback: gemini-3.1-flash-lite)
# GEMINI_PRIMARY_MODEL=gemini-3-flash-preview

# Optional: custom secret for HMAC-SHA256 shareable report signing
# REPORT_SIGNING_SECRET=your_random_32_char_secret_here
